{
  "manifest_version": 3,
  "name": "LinkedIn Assist",
  "description": "Generates suggestions for LinkedIn messages and comments using AI.",
  "version": "0.2.0",
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["src/content-scripts/job-description.js"],
      "css": ["styles.css"]
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "exclude_matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["src/content-scripts/editable-text-area.js"],
      "css": ["styles.css"]
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["src/content-scripts/profile.js"],
      "css": ["styles.css"]
    }
  ],
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "scraper-light",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  }
}
