{
  "manifest_version": 3,
  "name": "LinkedIn Assist",
  "description": "Generates suggestions for LinkedIn messages and comments using AI.",
  "version": "0.1.3",
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["src/content-scripts/job-description.js"],
      "css": ["styles.css"]
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "exclude_matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["src/content-scripts/editable-text-area.js"],
      "css": ["styles.css"]
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["src/content-scripts/profile.js"],
      "css": ["styles.css"]
    }
  ],
  "permissions": ["storage"],
  "action": {
    "default_title": "scraper-light"
  }
}
