{
  "mcpServers": {
    "context-mode": {
      "command": "context-mode"
    },
    "context7": {
      "command": "context7-mcp",
      "args": ["--api-key", "${CONTEXT7_API_KEY}"]
    },
    "fallow": {
      "command": "fallow-mcp"
    },
    "playwright-chrome": {
      "command": "playwright-mcp",
      "args": ["--browser", "chrome", "--output-dir", ".playwright-mcp"]
    },
    "internet-search": {
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey=${TAVILY_API_KEY}",
      "type": "http"
    },
    "graft": {
      "command": "graft",
      "args": ["mcp"]
    }
  }
}
